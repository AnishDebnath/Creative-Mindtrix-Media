# Cloudinary CDN Configuration
VITE_CLOUDINARY_IMAGE_BASE_URL=https://res.cloudinary.com/<your_cloud_name>/image/upload
VITE_CLOUDINARY_VIDEO_BASE_URL=https://res.cloudinary.com/<your_cloud_name>/video/upload

# Resend Mail Service Configuration
# 1. Get your API key from https://resend.com/api-keys:
RESEND_API_KEY=your_resend_api_key_here

# 2. Sender email (Use onboarding@resend.dev for initial testing, or your verified domain sender):
RESEND_FROM_EMAIL=Your Brand <onboarding@resend.dev>

# 3. Receiver email: The inbox where client inquiry notifications will be delivered
CONTACT_RECEIVER_EMAIL=your_inbox@yourdomain.com
